# VidoraX API
#
# DEVELOPMENT
# - Use localhost for iOS Simulator / local tooling.
# - Android Emulator rewrites localhost → 10.0.2.2 at runtime
#   (see src/constants/environment.ts).
# - Physical device: set your Mac LAN IP, e.g.
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.x.x:3105
#
# RELEASE / PRODUCTION
# - Do NOT ship localhost or a developer LAN IP in release builds.
# - Point EXPO_PUBLIC_API_BASE_URL at your production HTTPS API host.
# - Never put JWT secrets, database URLs, or service-role keys in EXPO_PUBLIC_*.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3105

# Feature flags (optional)
# Development: browser enabled unless set to "false"
# Production: browser enabled only when set to "true"
# EXPO_PUBLIC_ENABLE_BROWSER=true
