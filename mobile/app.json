{
  "expo": {
    "name": "VidoraX",
    "slug": "vidorax",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logos/icon.png",
    "scheme": "vidorax",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/logos/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/logos/android-icon-foreground.png",
        "backgroundImage": "./assets/logos/android-icon-background.png",
        "monochromeImage": "./assets/logos/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.vidorax",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-file-system",
        {
          "enableFileSharing": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/logos/icon.png",
          "color": "#0B1220",
          "defaultChannel": "vidorax_download_events",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05070D",
          "image": "./assets/logos/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-sqlite",
        {
          "enableFTS": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "VidoraX needs access to your photos so you can pick a profile picture.",
          "cameraPermission": "VidoraX needs access to your camera so you can take a profile picture.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "expo-video",
      "expo-screen-orientation",
      "expo-navigation-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "origin": "https://vidorax.app"
      }
    }
  }
}
