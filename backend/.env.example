# Server
# production: NODE_ENV=production (disables WS query-token fallback unless WS_ALLOW_QUERY_TOKEN=1)
NODE_ENV=development
PORT=3105

# Security — placeholders only; never commit real secrets
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# production: set explicit allowed origins (not *)
CORS_ORIGIN=*
# Optional: force-enable WS ?access_token= for legacy clients/tests (off in production by default)
# WS_ALLOW_QUERY_TOKEN=1

# Database (Supabase PostgreSQL)
# Use the session pooler URL for application queries.
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Use the session pooler URL for Prisma migrations when the direct host is unreachable.
DIRECT_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Supabase Storage (avatars)
# The service role key is server-only. Never expose it to the mobile app.
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me-service-role-key
SUPABASE_AVATAR_BUCKET=avatars
# Hard server-side ceiling for an uploaded avatar (2 MB).
AVATAR_MAX_BYTES=2097152
