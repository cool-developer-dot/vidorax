{
  "name": "vidorax-backend",
  "version": "1.0.0",
  "description": "VidoraX API server",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node init && tsx watch src/server.ts",
    "build": "node init && prisma generate && tsc",
    "start": "node init && node dist/server.js",
    "typecheck": "tsc --noEmit",
    "verify:avatar": "node scripts/verify-avatar-endpoints.mjs",
    "verify:analyze": "MEDIA_ANALYSIS_ALLOW_LOOPBACK=1 tsx scripts/verify-media-analysis.ts",
    "verify:intelligence": "tsx scripts/verify-media-intelligence.ts",
    "verify:downloads": "tsx scripts/verify-download-contract.ts",
    "verify:phase3": "tsx scripts/verify-week7-day1-phase3.ts",
    "verify:day4-phase1": "tsx scripts/verify-week7-day4-phase1.ts",
    "verify:day4-phase2": "tsx scripts/verify-week7-day4-phase2.ts",
    "verify:day4-phase3": "tsx scripts/verify-week7-day4-phase3.ts",
    "verify:week7-final": "npm run verify:analyze && npm run verify:intelligence && npm run verify:downloads && npm run verify:phase3 && npm run verify:day4-phase1 && npm run verify:day4-phase2 && npm run verify:day4-phase3",
    "verify:week8-day1-phase1": "tsx scripts/verify-week8-day1-phase1.ts",
    "verify:week8-day1-phase2": "tsx scripts/verify-week8-day1-phase2.ts",
    "verify:week8-day1-phase3": "tsx scripts/verify-week8-day1-phase3.ts",
    "verify:week8-day1": "npm run verify:week8-day1-phase1 && npm run verify:week8-day1-phase2 && npm run verify:week8-day1-phase3 && npm run typecheck",
    "verify:week8-day3-phase1": "tsx scripts/verify-week8-day3-phase1.ts",
    "verify:week8-day3-phase2": "tsx scripts/verify-week8-day3-phase2.ts",
    "verify:week8-day3-phase3": "tsx scripts/verify-week8-day3-phase3.ts",
    "verify:week8-day3": "npm run verify:week8-day3-phase1 && npm run verify:week8-day3-phase2 && npm run verify:week8-day3-phase3",
    "verify:week8-day4-phase2": "tsx scripts/verify-week8-day4-phase2.ts",
    "verify:week8-day4-phase3": "tsx scripts/verify-week8-day4-phase3.ts",
    "verify:week8-final": "npm run verify:week8-day1 && npm run verify:week8-day3 && npm run verify:week8-day4-phase2 && npm run verify:week8-day4-phase3 && npm run verify:playback-sync-final",
    "verify:playback-sync-final": "tsx scripts/verify-playback-sync-final.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "^2.110.8",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.1.1",
    "@types/ws": "^8.18.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
